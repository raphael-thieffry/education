% example_lewandowski.in -- the worked example of part 3 (complete: run it as it is)
% FOLIO validation, story 79, example 240
%   Robert Lewandowski is a striker.  Strikers are soccer players.
%   Robert Lewandowski left Bayern Munchen.
%   If a player leaves a team they no longer play for that team.
%   Conclusion: Robert Lewandowski is a soccer player.

formulas(assumptions).
  striker(lewandowski).                                     % R. Lewandowski is a striker.
  all x (striker(x) -> soccer_player(x)).                   % Strikers are soccer players.
  left(lewandowski, bayern).                                % R. Lewandowski left Bayern Munchen.
  all x all t ((soccer_player(x) & left(x, t)) -> -plays_for(x, t)).
                                                            % If a player leaves a team ...
end_of_list.

formulas(goals).
  soccer_player(lewandowski).                               % R. Lewandowski is a soccer player.
end_of_list.
