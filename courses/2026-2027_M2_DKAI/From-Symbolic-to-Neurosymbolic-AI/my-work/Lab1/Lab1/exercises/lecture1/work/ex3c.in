% Exercise 3 -- "all" and "some"
%   All cats are mammals.  Some cats are black.  Are some mammals black?
% Predicates: cat/1, mammal/1, black/1.   Replace every ??? and run.

formulas(assumptions).
  all x (cat(x) -> mammal(x)).          % All cats are mammals.
  all x (cat(x) -> black(x)).          % All cats are black.
end_of_list.

formulas(goals).
  exists x (mammal(x) & black(x)).          % Some mammals are black.
end_of_list.
