% FOLIO validation, story 441, example 1270.  Same premises as p08_tom.in: copy them.
%   Conclusion: If Tom is not both a grumpy person and mean to animals,
%               then Tom is neither a grumpy person nor an animal lover.
formulas(assumptions).
  all p (nice(p) -> -mean(p)).     % No one nice to animals is also mean to animals.
  exists p (grumpy(p) & mean(p)).     % Some grumpy people are mean to animals.
  all p (lover(p) -> nice(p)).     % All animal lovers are nice to animals.
  all p (owner(p) -> lover(p)).     % All pet owners love animals.
  owner(tom).     % Tom is a pet owner.
end_of_list.

formulas(goals).
  -(grumpy(tom) & mean(tom)) -> (-grumpy(tom) & -lover(tom)).
end_of_list.
